# Copy this file to secrets/local/runtime.env and fill only the providers you use.
# Never commit secrets/local/runtime.env.

# Azure Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ASR_AZURE_ENDPOINT=

# Hugging Face hosted API or gated/private Hub models
HF_TOKEN=

# Google Cloud Speech-to-Text
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# Amazon Transcribe
AWS_PROFILE=
AWS_REGION=
AWS_S3_BUCKET=

# Accepted AWS bucket aliases for compatibility
ASR_AWS_S3_BUCKET=
AWS_TRANSCRIBE_BUCKET=
